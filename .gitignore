*.run/
*.run.md
.temp/

# Benchmark inputs are regenerated deterministically by each pattern's
# inputs/gen.py (.memory/02-bench-rules.md); gen.py is committed, blobs are not.
patterns/*/inputs/*.bin

__pycache__/
*.pyc

*.zip
*.tar.gz

# Diagnostic gate runs. `--skip`, `--no-build`, `--no-callgrind` and `--cells
# measured` all certify strictly less than a full run, so check.py writes them
# beside the full-run record rather than over it. Only the full-run record is
# committed evidence.
results/gate/*.partial.json

# maintained by user for understanding, do not interfere with research work
.web/